{
  "name": "gh-datadog-event",
  "version": "2.3.0",
  "description": "A TypeScript library for working with Datadog events",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run --config ./config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config ./config/vitest.config.ts",
    "lint": "eslint --config ./config/eslint.config.ts --ext .ts ./src",
    "lint:fix": "eslint --config ./config/eslint.config.ts --ext .ts ./src --fix",
    "format": "prettier --config ./config/prettier.config.ts \"**/*.{ts,tsx,js,jsx,json,md}\" --write",
    "format:check": "prettier --config ./config/prettier.config.ts \"**/*.{ts,tsx,js,jsx,json,md}\" --check",
    "docs": "typedoc --options ./config/typedoc/typedoc.config.ts",
    "docs:dev": "typedoc --watch --options ./config/typedoc/typedoc.config.ts",
    "build:docs": "npm run docs && npm run test:coverage",
    "build:action": "ncc build src/action.ts -o dist/action -m",
    "package": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && npm run build && npm run build:action",
    "test:watch": "vitest --config ./config/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:package": "node scripts/check-package.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sds9-org/datadog-event.git"
  },
  "keywords": [
    "datadog",
    "events",
    "monitoring",
    "typescript",
    "github-action"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sds9-org/datadog-event/issues"
  },
  "homepage": "https://github.com/sds9-org/datadog-event#readme",
  "devDependencies": {
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "ts-node": "^10.9.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@datadog/datadog-api-client": "1.64.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
